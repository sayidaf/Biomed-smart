rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BIOMEDLINK SECURITY RULES - PROTOTYPING VERSION
     *
     * Core Philosophy:
     * This ruleset enforces a Role-Based Access Control (RBAC) model combined with strict 
     * user-ownership for profile management and troubleshooting sessions. The system is designed 
     * for a hospital environment where access to equipment and logs is restricted based on 
     * professional roles (Admin, Biomedical Engineer, Technician).
     *
     * Data Structure:
     * - /userProfiles/{userId}: Private user data and system roles.
     * - /departments/{departmentId}: Metadata about hospital sections.
     * - /equipment/{equipmentId}: Central inventory of biomedical devices.
     * - /equipment/.../maintenanceLogs: Detailed service history for specific equipment.
     * - /equipment/.../aiTroubleshootingSessions: Interactive AI help sessions.
     * - /publicEquipmentShowcase/{equipmentId}: Publicly accessible images/data for the landing page.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getProfile() {
      // Ensure the user profile exists before attempting to read its data
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    function hasRole(role) {
      return isSignedIn() && getProfile().data.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isStaff() {
      return isAdmin() || hasRole('Biomedical Engineer') || hasRole('Technician');
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for UserProfile. Users can manage their own profile; Admins manage all.
     * @path /userProfiles/{userId}
     */
    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Allow create if user is creating their own profile OR if the requester is an Admin.
      allow create: if (isOwner(userId) && request.resource.data.id == userId) || isAdmin();
      // Allow update if owner AND they are not changing their role. Admins can update any profile (including roles).
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Hospital departments. Read-only for staff, CRUD for Admins.
     */
    match /departments/{departmentId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Core Equipment collection.
     */
    match /equipment/{equipmentId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && request.resource.data.id == equipmentId;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    /**
     * @description Maintenance logs for equipment. 
     */
    match /equipment/{equipmentId}/maintenanceLogs/{logId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && request.resource.data.equipmentId == equipmentId;
      allow update: if isOwner(resource.data.performedById) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description AI Troubleshooting sessions records.
     */
    match /equipment/{equipmentId}/aiTroubleshootingSessions/{sessionId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && request.resource.data.equipmentId == equipmentId && request.resource.data.engineerId == request.auth.uid;
      allow update: if isOwner(resource.data.engineerId) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isStaff();
        allow create: if isStaff() && request.resource.data.sessionId == sessionId && 
                         (isOwner(get(/databases/$(database)/documents/equipment/$(equipmentId)/aiTroubleshootingSessions/$(sessionId)).data.engineerId) || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    /**
     * @description Public mirror for landing page display.
     */
    match /publicEquipmentShowcase/{equipmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}