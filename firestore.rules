
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BIOMEDLINK SECURITY RULES - ROBUST EDITION
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role.lower() == role.lower();
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isStaff() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role.lower() in ['admin', 'biomedical engineer', 'technician']);
    }

    match /userProfiles/{userId} {
      allow get, update: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1 && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower()));
      allow create: if (isSignedIn() && request.resource.data.id == userId) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /departments/{departmentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /equipment/{equipmentId} {
      allow get, list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();

      match /maintenanceLogs/{logId} {
        allow get, list: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isAdmin();
      }

      match /aiTroubleshootingSessions/{sessionId} {
        allow get, list: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isAdmin();

        match /messages/{messageId} {
          allow get, list: if isStaff();
          allow create: if isStaff();
          allow update, delete: if isAdmin();
        }
      }
    }

    match /publicEquipmentShowcase/{equipmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
