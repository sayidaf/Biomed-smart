rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BIOMEDLINK SECURITY RULES
     * 
     * Enforces Role-Based Access Control (RBAC).
     * Note: getProfile() relies on the document ID matching request.auth.uid.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to get the user's role from their UID-based profile
    function getUserRole() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
             (getUserRole() == 'Admin' || getUserRole() == 'Biomedical Engineer' || getUserRole() == 'Technician');
    }

    // --- COLLECTION RULES ---

    match /userProfiles/{userId} {
      // Allow user to get their own profile OR Admins to see all
      allow get: if isOwner(userId) || isAdmin();
      
      // Allow listing profiles ONLY for Admins, 
      // OR for users searching for their own email (for Auto-Link protocol)
      // Note: request.query.filters.email == [request.auth.token.email] is the correct syntax for v2 rules
      allow list: if isAdmin() || (isSignedIn() && request.auth.token.email != null && request.query.filters.email == [request.auth.token.email]);
      
      allow create: if (isSignedIn() && request.resource.data.id == userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      
      // Allow users to delete temporary records matching their email during the auto-link cleanup
      allow delete: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    match /departments/{departmentId} {
      allow get, list: if isSignedIn(); // Allow reading for all logged in staff
      allow create, update, delete: if isAdmin();
    }

    match /equipment/{equipmentId} {
      allow get, list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /equipment/{equipmentId}/maintenanceLogs/{logId} {
      allow get, list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /equipment/{equipmentId}/aiTroubleshootingSessions/{sessionId} {
      allow get, list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isStaff();
        allow create: if isStaff();
        allow update, delete: if isAdmin();
      }
    }

    match /publicEquipmentShowcase/{equipmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}